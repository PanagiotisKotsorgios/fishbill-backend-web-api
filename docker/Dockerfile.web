FROM nginx:alpine
# cache-bust: 2026-07-19-assetlinks

# ── FishBill static assets (unchanged) ──────────────────────────────────────
COPY index.html          /var/www/fishbill/
COPY 404.html            /var/www/fishbill/
COPY 403.html            /var/www/fishbill/
COPY maintenance.html    /var/www/fishbill/
COPY reset-password.html /var/www/fishbill/
COPY robots.txt          /var/www/fishbill/
COPY admin/              /var/www/fishbill/admin/
COPY app/                /var/www/fishbill/app/
COPY accountant/         /var/www/fishbill/accountant/
COPY assets/             /var/www/fishbill/assets/
COPY legal/              /var/www/fishbill/legal/
COPY docs/               /var/www/fishbill/docs/

# ── Αγρότης static assets (served under /agrotis/*) ────────────────────────
COPY agrotis-admin-panel/ /var/www/fishbill/agrotis/admin/
COPY agrotis/legal/       /var/www/fishbill/agrotis/legal/

# ── Digital Asset Links (Android App Links verification) ───────────────────
# Served at /.well-known/assetlinks.json on BOTH master-app.gr and
# www.master-app.gr — required by Google Play Console for auto-verified
# https deep links to open the app instead of the browser.
COPY .well-known/         /var/www/fishbill/.well-known/

# Nginx config for Docker
COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK NONE
