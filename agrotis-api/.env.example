# Αγρότης API — copy to .env and fill in values.
# This is a SEPARATE environment from FishBill; do not share values.

NODE_ENV=production
PORT=4001

# ── MySQL (shared server, but ALL agrotis tables are prefixed with `ag_`
# so there is zero name collision with FishBill tables) ──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=agrotis
DB_PASSWORD=change-me
DB_NAME=agrotis

# ── JWT (do NOT reuse FishBill's secret) ──
JWT_SECRET=change-me-please-generate-a-long-random-string
JWT_ACCESS_TTL=1d
JWT_REFRESH_TTL=30d

# ── Wrapp STAGING (sandbox) ──
# Get sandbox credentials from https://wrapp.ai/el/api/becomeapartner#contact
WRAPP_BASE_URL=https://staging.wrapp.ai/api/v1
WRAPP_PARTNER_API_KEY=your-sandbox-partner-api-key
WRAPP_WEBHOOK_SECRET=

# ── Email (used for password reset, subscription notices) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Αγρότης <no-reply@agrotis.gr>"

# ── Optional: super-admin bootstrap (only used on first migrate) ──
BOOTSTRAP_ADMIN_EMAIL=admin@agrotis.gr
BOOTSTRAP_ADMIN_PASSWORD=change-me-please
