# ─────────────────────────────────────────────────────────────────────────────
# FishBill — Docker environment template
# Copy this file to .env.docker, fill in your values, then run:
#   docker compose up -d --build
# ─────────────────────────────────────────────────────────────────────────────

# Web port exposed on the host (change if 80 is already in use)
WEB_PORT=80

# ── MySQL ──────────────────────────────────────────────────────────────────
# Use a strong password — the API will refuse to start in production with a weak one
DB_ROOT_PASSWORD=change_me_strong_root_password
DB_NAME=fishbill_db
DB_USER=fishbill_user
DB_PASSWORD=change_me_strong_db_password

# ── Node.js API ────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Generate encryption key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Storage
PDF_STORAGE_PATH=./pdfs

# URLs — replace with your actual domain or server IP (no trailing slash)
APP_URL=http://your-domain.com
API_URL=http://your-domain.com/api
APP_BASE_URL=http://your-domain.com

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://your-domain.com

# Admin notification email (used as fallback when not set in DB)
ADMIN_EMAIL=admin@your-domain.com

# ── Optional integrations (configured via Admin Panel after first boot) ─────
# These are set in the DB through the Admin Panel → Platform Settings,
# NOT here.  Leave them blank unless you need to override at container level.
#
# BREVO_API_KEY=
# ETIMOLOGIERA_DEV_URL=
# ETIMOLOGIERA_PROD_URL=
# PLATFORM_GSIS_USERNAME=
# PLATFORM_GSIS_PASSWORD=
# PLATFORM_GSIS_CALLER_AFM=
