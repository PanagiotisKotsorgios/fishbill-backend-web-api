# =============================================================================
# FishBill — Production environment template
# Copy to .env.production, fill in ALL values, then run: make deploy
# =============================================================================

# Host port for the web server (80 or 443 if TLS terminated here)
WEB_PORT=80

# ── MySQL ──────────────────────────────────────────────────────────────────
# Both passwords must be strong — use at least 20 random characters
DB_ROOT_PASSWORD=CHANGE_ME_strong_root_password_here
DB_NAME=fishbill_db
DB_USER=fishbill_user
DB_PASSWORD=CHANGE_ME_strong_db_password_here

# ── Node.js API ────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=CHANGE_ME

# PDF storage path inside the container (leave as-is for Docker)
PDF_STORAGE_PATH=./pdfs

# ── URLs — no trailing slash ───────────────────────────────────────────────
# Replace with your actual domain (or server IP for testing)
APP_URL=https://your-domain.com
API_URL=https://your-domain.com/api
APP_BASE_URL=https://your-domain.com

# CORS — comma-separated origins the API will accept cross-origin requests from
CORS_ORIGINS=https://your-domain.com

# Admin notification email (fallback when not configured in DB)
ADMIN_EMAIL=admin@your-domain.com

# ── Optional integrations ──────────────────────────────────────────────────
# Configure these in Admin Panel → Platform Settings after first boot.
# Only set here if you need to override at the container level.
#
# BREVO_API_KEY=
# ETIMOLOGIERA_DEV_URL=
# ETIMOLOGIERA_PROD_URL=
# PLATFORM_GSIS_USERNAME=
# PLATFORM_GSIS_PASSWORD=
# PLATFORM_GSIS_CALLER_AFM=
