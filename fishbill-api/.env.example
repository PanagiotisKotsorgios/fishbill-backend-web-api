# Environment
NODE_ENV=development
PORT=4000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=fishbill_user
DB_PASSWORD=your_password
DB_NAME=fishbill_db

# JWT
JWT_SECRET=change_this_to_random_64_char_string_abcdefghijklmnopqrstuvwxyz123456
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_this_too_another_random_64_char_string_abcdefghijklmnop
JWT_REFRESH_EXPIRES_IN=30d

# Encryption (32-char hex key for AES-256)
ENCRYPTION_KEY=change_this_32_char_hex_key_here

# Storage
PDF_STORAGE_PATH=./pdfs

# URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
# Base URL for the web app (used in email links) — no trailing slash
APP_BASE_URL=http://localhost/fishbill

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost

# Admin notification email (fallback when not configured in DB)
ADMIN_EMAIL=admin@fishbill.gr

# Email (Brevo API key + sender — configured via Admin Panel → Platform Settings, not here)
